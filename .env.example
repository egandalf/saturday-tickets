# Atlas M0 for this project only. Do not reuse ky-drivers-exam-game credentials.
MONGODB_URI=
# Optional. Defaults to the URI path, then "saturday".
MONGODB_DB=
# Google AI Studio key, Flash / Flash-Lite free tier. Never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Voyage AI. Query embed for Atlas Vector Search. Never NEXT_PUBLIC_.
VOYAGE_API_KEY=
# OpenRouteService: drive times when dealing from anywhere but home, and geocoding. Never NEXT_PUBLIC_.
ORS_API_KEY=

# Local agents only (npm run scout:ui, npm run agent). Not needed on Vercel.
# Anthropic: runs the agents (Claude Sonnet 5).
ANTHROPIC_API_KEY=
# Tavily: web search and page reading for the agents.
TAVILY_API_KEY=
# Vercel Blob read-write token: approved places' photos go to photos/<id>.jpg.
BLOB_READ_WRITE_TOKEN=
